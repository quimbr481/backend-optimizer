[
 {
  "id": "cpu.prio",
  "cat": "Performance",
  "title": "Separação de prioridade (Win32PrioritySeparation)",
  "evidence": "community",
  "risk": "low",
  "admin": true,
  "desc": "Define quantum curto/fixo com boost 3:1 para a janela em primeiro plano (0x2A). O padrão de cliente (0x02) já usa quantum curto e variável; a diferença prática costuma ser pequena e depende do jogo — meça.",
  "changes": [
   {
    "hive": "HKLM",
    "path": "SYSTEM\\CurrentControlSet\\Control\\PriorityControl",
    "name": "Win32PrioritySeparation",
    "type": "REG_DWORD",
    "value": 42
   }
  ]
 },
