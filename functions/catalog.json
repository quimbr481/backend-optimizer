  "risk": "medium",
  "admin": true,
  "reboot": true,
  "desc": "OverlayTestMode=5 desativa o MPO no DWM. É uma correção para flicker/stutter/tela preta em alguns drivers — NÃO é um ganho geral de latência. Aplique só se tiver o sintoma.",
  "changes": [
   {
    "hive": "HKLM",
    "path": "SOFTWARE\\Microsoft\\Windows\\Dwm",
    "name": "OverlayTestMode",
    "type": "REG_DWORD",
    "value": 5
   }
  ]
 },
